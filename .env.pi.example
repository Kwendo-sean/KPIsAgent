# ─────────────────────────────────────────────────────────────────────────────
# Raspberry Pi 5 — TREPLEX-AIOT edge deployment
#
# Copy to `.env` ON THE PI ONLY:   cp .env.pi.example .env
#
# DO NOT copy the development .env from the laptop. This file must contain
# NO cloud AI keys. Their absence is a second, independent guarantee that no
# bank statement can leave the device: every cloud provider function returns
# immediately when its key is missing, on top of the LOCAL_AI_MODE gate.
# ─────────────────────────────────────────────────────────────────────────────

# ── Local AI (llama-server, already running under treplex-llm.service) ───────
LOCAL_AI_MODE=true
LOCAL_AI_BASE_URL=http://127.0.0.1:8081/v1
LOCAL_AI_MODEL=qwen2.5-0.5b-instruct
LOCAL_AI_TIMEOUT=120
# Ceiling on generated tokens. llama-server context is 1024 — do not raise
# this without also raising the server's context, which is out of scope.
LOCAL_AI_MAX_TOKENS=384

# ── Django ───────────────────────────────────────────────────────────────────
# Generate a fresh key on the Pi, do not reuse the development one:
#   python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE-ME-generate-a-fresh-key-on-the-pi

# Demo runs on an isolated network with no internet. DEBUG=True is a
# deliberate choice so `runserver` serves static files without collectstatic.
DEBUG=True

ALLOWED_HOSTS=10.42.0.1,127.0.0.1,localhost

# Required by Django 4.2 or every upload/AJAX POST fails CSRF validation.
CSRF_TRUSTED_ORIGINS=http://10.42.0.1:8090,http://127.0.0.1:8090
EXTRA_CORS_ORIGINS=http://10.42.0.1:8090

# One background worker — 4 GB shared with llama-server.
Q_WORKERS=1

TIME_ZONE=Africa/Nairobi
BASE_CURRENCY=KES

# ── Deliberately absent ──────────────────────────────────────────────────────
# ANTHROPIC_API_KEY, GROQ_API_KEY, GEMINI_API_KEY, FIREWORKS_API_KEY,
# OPENROUTER_API_KEY, LLM7_API_KEY, LLM7_API_KEY_2, LLM7_API_KEY_3
#
# If any of these are set while LOCAL_AI_MODE=true, the app logs a prominent
# security warning at startup (names only, never values).

# ── Optional: email. Leave unset — the console backend is used, and the Pi
# has no internet during the demo anyway.
